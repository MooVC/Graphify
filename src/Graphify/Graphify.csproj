<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <Description>Graphify, a .NET Roslyn source generator, allows for the efficient navigation of a class hierarchy, without the use of reflection.</Description>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetAnalyzerDependencyTargetPaths</GetTargetPathDependsOn>
    <GraphifyBootstrapVersion>1.1.3</GraphifyBootstrapVersion>
    <!-- Keep the bootstrap-generated contracts in the analyzer load context. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerDependencies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <!-- Download the published generator without creating a NuGet dependency on Graphify itself. -->
    <PackageDownload Include="Graphify" Version="[$(GraphifyBootstrapVersion)]" />
    <Analyzer Include="$(NuGetPackageRoot)/graphify/$(GraphifyBootstrapVersion)/analyzers/dotnet/cs/Graphify.dll" />
    <PackageReference Include="MooVC.Syntax.CSharp" PrivateAssets="all" />
    <PackageReference Include="Valuify">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="GraphifyAttributeAnalyzer.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GraphifyAttributeAnalyzer.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="GraphifyAttributeGenerator.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GraphifyAttributeGenerator.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Syntax\SubjectExtensions.ToNavigatorSource.Resources.Designer.cs">
      <DependentUpon>SubjectExtensions.ToNavigatorSource.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Syntax\SubjectExtensions.ToRegistrationSource.Resources.Designer.cs">
      <DependentUpon>SubjectExtensions.ToRegistrationSource.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Visitors\GenerateAsynchronousNavigatorWhenNodeVisited.Resources.Designer.cs">
      <DependentUpon>GenerateAsynchronousNavigatorWhenNodeVisited.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Visitors\GenerateAsynchronousNavigatorWhenSubjectVisited.Resources.Designer.cs">
      <DependentUpon>GenerateAsynchronousNavigatorWhenSubjectVisited.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Visitors\GenerateSynchronousNavigatorWhenNodeVisited.Resources.Designer.cs">
      <DependentUpon>GenerateSynchronousNavigatorWhenNodeVisited.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Visitors\GenerateSynchronousNavigatorWhenSubjectVisited.Resources.Designer.cs">
      <DependentUpon>GenerateSynchronousNavigatorWhenSubjectVisited.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="NavigatorExtensionsGenerator.Resources.Designer.cs">
      <DependentUpon>NavigatorExtensionsGenerator.Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="TraverseAttributeGenerator.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TraverseAttributeGenerator.Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="TypeGenerator.Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TypeGenerator.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
    <EmbeddedResource Update="GraphifyAttributeAnalyzer.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>GraphifyAttributeAnalyzer.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="GraphifyAttributeGenerator.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GraphifyAttributeGenerator.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Syntax\SubjectExtensions.ToNavigatorSource.Resources.resx">
      <LastGenOutput>SubjectExtensions.ToNavigatorSource.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Syntax\SubjectExtensions.ToRegistrationSource.Resources.resx">
      <LastGenOutput>SubjectExtensions.ToRegistrationSource.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateAsynchronousNavigatorWhenNodeVisited.Resources.resx">
      <LastGenOutput>GenerateAsynchronousNavigatorWhenNodeVisited.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateAsynchronousNavigatorWhenSubjectVisited.Resources.resx">
      <LastGenOutput>GenerateAsynchronousNavigatorWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateSynchronousNavigatorWhenNodeVisited.Resources.resx">
      <LastGenOutput>GenerateSynchronousNavigatorWhenNodeVisited.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Visitors\GenerateSynchronousNavigatorWhenSubjectVisited.Resources.resx">
      <LastGenOutput>GenerateSynchronousNavigatorWhenSubjectVisited.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="NavigatorExtensionsGenerator.Resources.resx">
      <LastGenOutput>NavigatorExtensionsGenerator.Resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="TraverseAttributeGenerator.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TraverseAttributeGenerator.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="TypeGenerator.Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TypeGenerator.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="ResolveAnalyzerDependencies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_AnalyzerDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'
                                      AND '%(ReferenceCopyLocalPaths.Filename)' != '$(AssemblyName)'
                                      AND '%(ReferenceCopyLocalPaths.Filename)' != 'Valuify'
                                      AND !$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('Microsoft.CodeAnalysis'))" />
    </ItemGroup>
  </Target>
  <Target Name="GetAnalyzerDependencyTargetPaths" Condition="'$(IncludeAnalyzerDependencies)' == 'true'" DependsOnTargets="ResolveAnalyzerDependencies">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_AnalyzerDependency)" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
  <Target Name="PackAnalyzerDependencies" DependsOnTargets="ResolveAnalyzerDependencies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_AnalyzerDependency)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>